# OpenAI API
OPENAI_API_KEY=sk-...

# GitHub (Personal Access Token mit repo-Rechten)
GITHUB_TOKEN=ghp_...
# Optional: Standard-Repository (leer lassen = alle Repos verfügbar)
GITHUB_REPO=

# Notion (Integration Token)
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sprachausgabe: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=alloy
